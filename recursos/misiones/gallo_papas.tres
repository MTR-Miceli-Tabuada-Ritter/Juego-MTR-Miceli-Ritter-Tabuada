[gd_resource type="Resource" script_class="Mision" load_steps=5 format=3]

[ext_resource type="Script" path="res://globales/misiones/mision.gd" id="1_mision"]
[ext_resource type="Script" path="res://globales/misiones/objetivo_entregar_items.gd" id="2_entrega"]
[ext_resource type="Script" path="res://globales/misiones/objetivo_mision.gd" id="3_base"]

[sub_resource type="Resource" id="Objetivo_papas"]
script = ExtResource("2_entrega")
id = "entregar_papas"
descripcion = "Entregale tres papas cosechadas al Gallo."
item_id = "cultivo_2"
cantidad_requerida = 3

[resource]
script = ExtResource("1_mision")
id = "gallo_papas"
titulo = "Tres papas para el Gallo"
descripcion = "El Gallo necesita tres papas, no semillas."
npc_otorgante_id = "gallo"
npc_receptor_id = "gallo"
objetivos = Array[ExtResource("3_base")]([SubResource("Objetivo_papas")])
recompensa_dinero = 30